{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build && rm -rf dist && mkdir -p dist && cp -r public/. dist/ && rm -f dist/index.php dist/.htaccess",
    "outputDirectory": "dist",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "maxDuration": 30
        }
    },
    "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
